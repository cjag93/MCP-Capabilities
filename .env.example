# Playwright / Eyes test run
APPLITOOLS_API_KEY=

# Scoped keys from Applitools Admin → Teams → API Keys.
# Inspect only needs read. Resolve (accept/reject/save) needs write.
APPLITOOLS_READ_KEY=
APPLITOOLS_WRITE_KEY=

# Cursor SDK — required to launch the CI agent (npm run ci:agent).
# Create at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional. Public cloud is the default.
# APPLITOOLS_SERVER_URL=https://eyes.applitools.com

# Enables the inspect / resolve MCP tools (keep true for this project).
BETA_v0_5_16_2832=true

# accept | reject — applied to unresolved / new steps during CI resolve.
EYES_RESOLVE_ACTION=accept

# Set to 1 to persist pending resolve decisions to the baseline.
EYES_RESOLVE_SAVE=1
